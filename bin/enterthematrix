#!/bin/bash
# Enter the Matrix: the digital rain, fullscreen.
#
#   enterthematrix                 the default version
#   enterthematrix operator        a specific one
#   enterthematrix --list          what is available
#   enterthematrix --tty           the rain in this terminal, no window
#
# While it runs: v next version, i replay the intro, f fps, h hint, q quit.

set -uo pipefail

# Resolve the install root whether this is the real file or a symlink to it.
SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
  DIR="$(cd -P "$(dirname "$SELF")" && pwd)"
  SELF="$(readlink "$SELF")"
  [[ $SELF != /* ]] && SELF="$DIR/$SELF"
done
ROOT="$(cd -P "$(dirname "$SELF")/.." && pwd)"

# The names come from provider.json rather than by parsing the JS: it is a
# declared product file and a flat array, so no JS evaluation is needed.
versions() {
  sed -n 's/.*"available": \[\(.*\)\].*/\1/p' "$ROOT/provider.json" \
    | tr -d '"' | tr ',' '\n' | sed 's/^ *//; s/ *$//' | grep -v '^$'
}

case "${1:-}" in
  -h|--help) sed -n '2,9p' "$SELF" | sed 's/^# \{0,1\}//'; exit 0 ;;
  --list)    versions | sed 's/^/  /'; exit 0 ;;
  --tty)
    shift
    # --font only means anything if the terminal is actually using Matrix-Code,
    # and we cannot change the font of the terminal we were typed into. So open
    # one that has it, the way Omarchy's own screensaver does. MATRIX_IN_TERM
    # stops the spawned instance from spawning another.
    if [[ " $* " == *" --font "* && -z ${MATRIX_IN_TERM:-} ]]; then
      size="${MATRIX_FONT_SIZE:-9}"
      for t in ghostty foot alacritty kitty; do
        command -v "$t" >/dev/null || continue
        case $t in
          ghostty)   exec env MATRIX_IN_TERM=1 ghostty --font-family="Matrix-Code" --font-size="$size" \
                       -e "$ROOT/bin/enterthematrix-tty" "$@" ;;
          foot)      exec env MATRIX_IN_TERM=1 foot --font="Matrix-Code:size=$size" \
                       -e "$ROOT/bin/enterthematrix-tty" "$@" ;;
          alacritty) exec env MATRIX_IN_TERM=1 alacritty -o "font.normal.family=Matrix-Code" \
                       -o "font.size=$size" -e "$ROOT/bin/enterthematrix-tty" "$@" ;;
          kitty)     exec env MATRIX_IN_TERM=1 kitty -o font_family="Matrix-Code" \
                       -o font_size="$size" "$ROOT/bin/enterthematrix-tty" "$@" ;;
        esac
      done
      echo "enterthematrix: no ghostty, foot, alacritty or kitty to open with the font." >&2
      echo "Running here instead; set Matrix-Code as your terminal font to see it." >&2
    fi
    exec "$ROOT/bin/enterthematrix-tty" "$@" ;;
esac

command -v qml6 >/dev/null || {
  echo "enterthematrix: qml6 is missing. Install qt6-declarative." >&2; exit 1; }
[[ -f $ROOT/shaders/rain.frag.qsb ]] || {
  echo "enterthematrix: compiled shaders are missing from $ROOT/shaders." >&2
  echo "If you are running from a source tree, run $ROOT/tools/build-shaders.sh" >&2; exit 1; }

VERSION="${1:-}"
if [[ -n $VERSION ]] && ! versions | grep -qx "$VERSION"; then
  echo "enterthematrix: no version called '$VERSION'. Try --list." >&2; exit 1
fi

if [[ -n $VERSION ]]; then
  exec qml6 "$ROOT/qml/Main.qml" -- "version=$VERSION"
else
  exec qml6 "$ROOT/qml/Main.qml"
fi
