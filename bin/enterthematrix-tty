#!/usr/bin/env python3
"""The rain, in the terminal.

The same field as the shader: getRainBrightness is ported verbatim from
shaders/rain.frag, wobble and all, so a column falls here exactly as it falls
there. What changes is the renderer -- character cells instead of MSDF glyphs,
and no bloom, because a terminal has neither.

Two glyph modes, because a terminal cannot give you both authenticity and a
tight grid:

  narrow (default)  The katakana mapped to their halfwidth codepoints. One
                    terminal cell each, so the grid is tight and it works in
                    any font. This is what ttfx and every other terminal rain
                    does.

  --font            The codepoints Matrix-Code.ttf actually maps. With that
                    font set in your terminal these are the film's own glyphs,
                    but its katakana are Unicode-wide: the terminal reserves
                    two cells while the glyph draws at 0.934 em, about one. So
                    each column is two cells wide and the glyphs sit loose in
                    them. All 58 codepoints, versus 34 in narrow mode.

Pure stdlib: no numpy, no curses, nothing to install.
"""

import math, os, random, re, select, signal, struct, sys, termios, time, tty
from pathlib import Path

SQRT_2, SQRT_5 = math.sqrt(2), math.sqrt(5)

# Same palette stops as the shader's `classic`, as (r,g,b,at).
PALETTE = [(0.000, 0.000, 0.000, 0.0),
           (0.092, 0.380, 0.020, 0.2),
           (0.538, 0.970, 0.430, 0.7),
           (0.692, 0.980, 0.620, 0.8)]
CURSOR = (0.7559, 1.0, 0.46)

FALLBACK = "\"*+012345789:<>z|¦©ｱｳｴｵｶｷｹｺｻｼｽｾｿﾀﾂﾃﾅﾆﾇﾈﾊﾋﾎﾏﾐﾑﾒﾓﾔﾖﾗﾘﾜｰ"

# Every fullwidth katakana has a halfwidth twin, and Unicode records it as a
# <narrow> compatibility decomposition. That is how the font's own codepoints
# become one-cell characters.
def _halfwidth_map():
    import unicodedata
    m = {}
    for cp in range(0xFF61, 0xFFA0):
        d = unicodedata.decomposition(chr(cp))
        if d.startswith("<narrow>"):
            m[int(d.split()[-1], 16)] = chr(cp)
    return m


def font_codepoints():
    """Read the cmap of Matrix-Code.ttf if we can find it, else return None."""
    for p in (Path.home()/"Downloads/Matrix-Code.ttf",
              Path("/usr/share/fonts/matrix-code/Matrix-Code.ttf"),
              Path(__file__).resolve().parent.parent/"assets/Matrix-Code.ttf"):
        try:
            d = p.read_bytes()
        except OSError:
            continue
        try:
            n = struct.unpack(">H", d[4:6])[0]
            tabs = {d[12+i*16:16+i*16].decode("latin1"):
                    struct.unpack(">II", d[20+i*16:28+i*16]) for i in range(n)}
            co = tabs["cmap"][0]
            sub = None
            for i in range(struct.unpack(">H", d[co+2:co+4])[0]):
                off = struct.unpack(">HHI", d[co+4+i*8:co+12+i*8])[2]
                if struct.unpack(">H", d[co+off:co+off+2])[0] == 4:
                    sub = co+off
            segX2 = struct.unpack(">H", d[sub+6:sub+8])[0]
            seg = segX2//2
            ends = struct.unpack(">%dH" % seg, d[sub+14:sub+14+segX2])
            starts = struct.unpack(">%dH" % seg, d[sub+16+segX2:sub+16+2*segX2])
            out = []
            for s, e in zip(starts, ends):
                if s == 0xFFFF:
                    continue
                out += [c for c in range(s, min(e, 0xFFFF)+1) if c >= 33]
            if out:
                return out
        except Exception:
            continue
    return None


def glyph_set(use_font):
    """The characters to rain, and how many terminal cells each one takes."""
    import unicodedata
    cps = font_codepoints()
    if cps is None:
        return FALLBACK, 1
    if use_font:
        # The font's own codepoints. Keep only what actually renders, and drop
        # the private-use and replacement ones the cmap also lists.
        keep = [c for c in cps if c != 0xFFFD and not (0xE000 <= c <= 0xF8FF)]
        return "".join(chr(c) for c in keep), 2
    # Narrow mode: fold the fullwidth katakana down to their halfwidth twins and
    # keep only characters that occupy a single cell.
    half = _halfwidth_map()
    out = []
    for c in cps:
        # U+FFFD passes isprintable() and is not flagged wide, so it has to go
        # by codepoint, along with the private-use area the cmap also lists.
        if c == 0xFFFD or 0xE000 <= c <= 0xF8FF:
            continue
        ch = half.get(c, chr(c))
        if not ch.isprintable():
            continue
        if unicodedata.east_asian_width(ch) in ("W", "F"):
            continue
        out.append(ch)
    return "".join(out) or FALLBACK, 1


def rand_float(x, y):
    """The shader's randomFloat, to the digit: the field must match."""
    dt = x*12.9898 + y*78.233
    return math.modf(math.sin(math.fmod(dt, math.pi)) * 43758.5453)[0] % 1.0


def wobble(x):
    return x + 0.3*math.sin(SQRT_2*x) + 0.2*math.sin(SQRT_5*x)


def palette(t):
    t = 0.0 if t < 0 else (1.0 if t > 1 else t)
    for (r0, g0, b0, a0), (r1, g1, b1, a1) in zip(PALETTE, PALETTE[1:]):
        if t <= a1:
            f = 0 if a1 == a0 else (t-a0)/(a1-a0)
            return (r0+(r1-r0)*f, g0+(g1-g0)*f, b0+(b1-b0)*f)
    return PALETTE[-1][:3]


class Rain:
    def __init__(self, cols, rows, use_font=False, fall=0.3, length=None,
                 cycles=1.8, contrast=1.1, brightness=-0.5):
        self.fall, self.cycles = fall, cycles
        self._length_fixed = length   # None means: scale it to the terminal
        self.length = length or 0.75
        self.contrast, self.brightness = contrast, brightness
        self.glyphs, self.cell_w = glyph_set(use_font)
        # In --font mode a rain column is two terminal cells, but the set mixes
        # the font's fullwidth katakana with narrow digits and symbols. Printing
        # a narrow one advances a single cell and every column after it on that
        # row slides left. Pad them so each glyph occupies the same width.
        import unicodedata as _u
        self.padded = ["".join([g, " "]) if self.cell_w == 2
                       and _u.east_asian_width(g) not in ("W", "F") else g
                       for g in self.glyphs]
        self.resize(cols, rows)

    def resize(self, term_cols, rows):
        # A rain column is cell_w terminal columns: the font's katakana are
        # Unicode-wide and the terminal gives them two.
        cols = max(1, term_cols // self.cell_w)
        self.cols, self.rows = cols, rows
        # A drop advances y*0.01/raindropLength per row, so upstream's 0.75 is a
        # 75-row period. That is right for the shader, where a 1080p screen at
        # 9pt is 72 rows and one drop fills it. A terminal is half that tall, so
        # a fixed 0.75 shows less than half a drop and the rain reads as blocks
        # instead of streaks. Scale it so one drop spans the window, as it does
        # there.
        if self._length_fixed is None:
            self.length = 0.01 * max(8, rows)
        # Per-column constants: the shader recomputes these per fragment, but
        # they only depend on x, so here they are hoisted out of the loop.
        self.off = [rand_float(x, 0.0)*1000.0 for x in range(cols)]
        self.spd = [rand_float(x+0.1, 0.0)*0.5+0.5 for x in range(cols)]
        # Initial glyph age and symbol per cell, as the shader draws them.
        self.age0 = [[rand_float(x/cols+0.5, y/rows+0.5) for y in range(rows+1)]
                     for x in range(cols)]
        self.sym0 = [[int(len(self.glyphs)*rand_float(x/cols, y/rows)) % len(self.glyphs)
                      for y in range(rows+1)] for x in range(cols)]

    # The shader's y grows UPWARD -- rain.frag flips the texture coordinate for
    # exactly this reason -- while a terminal row number grows downward. Without
    # converting, the rain falls up. It did, until this was measured.
    def _y(self, row):
        return self.rows - 1 - row

    def brightness_at(self, x, row, t):
        y = self._y(row)
        ct = self.off[x] + t*self.fall*self.spd[x]
        return 1.0 - (wobble((y*0.01 + ct)/self.length) % 1.0)

    def glyph_at(self, x, row, t):
        y = self._y(row)
        a0 = self.age0[x][y]
        k = math.floor(a0 + self.cycles*t)
        if k < 1:
            return self.padded[self.sym0[x][y]]
        tk = (k - a0)/self.cycles
        return self.padded[int(len(self.glyphs)*rand_float(x/self.cols, y/self.rows + tk))
                           % len(self.glyphs)]


def run(rain, fps=20):
    out = sys.stdout.write
    last = None
    frame_time = 1.0/fps
    t0 = time.monotonic()
    while True:
        t = time.monotonic() - t0
        buf = ["\x1b[H"]
        prev = None
        for y in range(rain.rows):
            for x in range(rain.cols):
                b = rain.brightness_at(x, y, t)
                # One row lower ON SCREEN, which is row+1 here.
                below = rain.brightness_at(x, y+1, t) if y+1 < rain.rows else 0.0
                lit = b*rain.contrast + rain.brightness
                if lit <= 0.02:
                    if prev is not None:
                        buf.append("\x1b[0m"); prev = None
                    buf.append(" " * rain.cell_w)
                    continue
                r, g, bl = CURSOR if b > below else palette(lit)
                col = (int(r*255*min(1, lit*2 if b > below else 1)),
                       int(g*255), int(bl*255))
                if col != prev:
                    buf.append("\x1b[38;2;%d;%d;%dm" % col); prev = col
                buf.append(rain.glyph_at(x, y, t))
            if y < rain.rows-1:
                buf.append("\r\n")
        out("".join(buf)); sys.stdout.flush()
        dt = frame_time - (time.monotonic() - t0 - t)
        if select.select([sys.stdin], [], [], max(0.0, dt))[0]:
            return


USAGE = """the rain, in the terminal

  enterthematrix --tty            halfwidth katakana, one cell, any font
  enterthematrix --tty --font     the codepoints Matrix-Code.ttf maps, two
                                  cells wide; set that font in your terminal

  MATRIX_FPS=30 to change the frame rate. Any key quits.
"""


def main():
    args = sys.argv[1:]
    if "-h" in args or "--help" in args:
        print(USAGE); return
    use_font = "--font" in args
    if not sys.stdout.isatty():
        sys.exit("enterthematrix-tty: needs a terminal")
    fd = sys.stdin.fileno()
    saved = termios.tcgetattr(fd)
    cols, rows = os.get_terminal_size()
    rain = Rain(cols, rows, use_font=use_font)

    def on_resize(*_):
        c, r = os.get_terminal_size()
        rain.resize(c, r)
    signal.signal(signal.SIGWINCH, on_resize)

    try:
        tty.setraw(fd)
        sys.stdout.write("\x1b[?1049h\x1b[?25l\x1b[2J")
        run(rain, fps=int(os.environ.get("MATRIX_FPS", "20")))
    except KeyboardInterrupt:
        pass
    finally:
        sys.stdout.write("\x1b[0m\x1b[?25h\x1b[?1049l")
        sys.stdout.flush()
        termios.tcsetattr(fd, termios.TCSADRAIN, saved)


if __name__ == "__main__":
    main()
